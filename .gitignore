# ── 构建产物 ──
Src/bin/
Src/obj/
App/*.exe
App/*.dll
App/*.deps.json
App/*.runtimeconfig.json
App/runtimes/
App/*.pdb

# ── 运行时状态（本机数据，不该进仓库）──
App/install-history.json
App/keyboard-layout.txt
App/debug.log
App/*.log
App/Downloads/
App/Backup/

# ── VS 缓存 ──
.vs/

# ── 发布产物（自包含 150 MB，不进仓库）──
Dist/
*.user
*.suo
*.userprefs

# ── 系统垃圾 ──
Thumbs.db
desktop.ini
.DS_Store
